{
  "expo": {
    "name": "agenda-recordatorios",
    "slug": "agenda-recordatorios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#397253",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Permitir agregar tus eventos al calendario del teléfono."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir elegir una foto para un evento.",
          "cameraPermission": "Permitir tomar una foto para un evento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir adjuntar tu ubicación actual a un evento."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permitir elegir un contacto para un evento."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#397253"
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
